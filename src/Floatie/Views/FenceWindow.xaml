<Window x:Class="Floatie.Views.FenceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" ResizeMode="CanResizeWithGrip" MinWidth="200" MinHeight="40"
        FontFamily="{StaticResource UiFont}" AllowDrop="True" Title="Floatie fence"
        DragOver="OnDragOver" Drop="OnDrop" DragLeave="OnDragLeave">
    <Window.Resources>
        <Style x:Key="Tile" TargetType="ListBoxItem">
            <Setter Property="Margin" Value="2"/>
            <Setter Property="Padding" Value="4,6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="b" Background="Transparent" CornerRadius="7" Padding="{TemplateBinding Padding}"
                                BorderThickness="1" BorderBrush="Transparent">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Background" Value="{StaticResource Hover}"/></Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="b" Property="Background" Value="{StaticResource Selected}"/>
                                <Setter TargetName="b" Property="BorderBrush" Value="#55FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ResizeGrip">
            <Setter Property="Opacity" Value="0.35"/>
        </Style>
    </Window.Resources>

    <Border x:Name="Frame" Background="{StaticResource Panel}" BorderBrush="{StaticResource PanelBorder}"
            BorderThickness="1" CornerRadius="10">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="38"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- header: drag to move, double-click to roll up -->
            <Grid x:Name="Header" Background="Transparent" MouseLeftButtonDown="OnHeaderMouseDown"
                  ContextMenuOpening="OnFenceMenuOpening">
                <Grid.ContextMenu><ContextMenu x:Name="FenceMenu"/></Grid.ContextMenu>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Border x:Name="AccentBar" Width="4" Height="16" CornerRadius="2" Margin="12,0,9,0" Background="{StaticResource Accent}"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="TitleText" FontFamily="{StaticResource DisplayFont}" FontWeight="SemiBold" FontSize="13.5"
                               Foreground="{StaticResource Ink}" TextTrimming="CharacterEllipsis"/>
                    <TextBlock x:Name="CountText" Foreground="{StaticResource Muted}" FontSize="12" Margin="8,1,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="0,0,6,0" VerticalAlignment="Center">
                    <Button Style="{StaticResource IconButton}" Content="&#xE721;" ToolTip="Filter (Ctrl+F)" AutomationProperties.Name="Filter" Click="OnSearchClick"/>
                    <Button Style="{StaticResource IconButton}" Content="&#xE712;" ToolTip="Fence options" AutomationProperties.Name="Fence options" Click="OnMenuClick"/>
                    <Button x:Name="RollButton" AutomationProperties.Name="Roll up" Style="{StaticResource IconButton}" Content="&#xE70E;" ToolTip="Roll up (double-click the title)" Click="OnRollClick"/>
                </StackPanel>
            </Grid>

            <TextBox x:Name="SearchBox" Grid.Row="1" Margin="10,0,10,6" Visibility="Collapsed"
                     TextChanged="OnSearchChanged" PreviewKeyDown="OnSearchKeyDown"/>

            <Grid Grid.Row="2" x:Name="Body">
                <ListBox x:Name="Items" Background="Transparent" BorderThickness="0" Margin="6,0,4,8"
                         SelectionMode="Extended" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ItemContainerStyle="{StaticResource Tile}"
                         MouseDoubleClick="OnItemDoubleClick" PreviewMouseLeftButtonDown="OnItemsMouseDown"
                         PreviewMouseMove="OnItemsMouseMove" KeyDown="OnItemsKeyDown"
                         ContextMenuOpening="OnItemsMenuOpening">
                    <ListBox.ContextMenu><ContextMenu x:Name="ItemMenu"/></ListBox.ContextMenu>
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Width="78" ToolTip="{Binding Tooltip}">
                                <Image Source="{Binding Icon}" Width="40" Height="40" Margin="0,0,0,5"
                                       RenderOptions.BitmapScalingMode="HighQuality"/>
                                <TextBlock Text="{Binding Name}" Foreground="{StaticResource Ink}" FontSize="11.5"
                                           TextAlignment="Center" TextWrapping="Wrap" TextTrimming="CharacterEllipsis"
                                           MaxHeight="31" LineHeight="15" LineStackingStrategy="BlockLineHeight"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <TextBlock x:Name="EmptyText" Foreground="{StaticResource Muted}" FontSize="12.5" TextAlignment="Center"
                           TextWrapping="Wrap" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="24"
                           IsHitTestVisible="False"/>
                <Border x:Name="DropHint" CornerRadius="8" Margin="8,0,8,8" BorderThickness="2" Visibility="Collapsed"
                        BorderBrush="{StaticResource Accent}" Background="#143DBFA7" IsHitTestVisible="False">
                    <TextBlock x:Name="DropText" Foreground="{StaticResource Ink}" FontWeight="SemiBold"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>
