<Window x:Class="Floatie.Views.InputDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource Dialog}" ShowInTaskbar="False" WindowStartupLocation="CenterOwner">
    <StackPanel Margin="22,8,22,20" Width="340">
        <TextBlock x:Name="Prompt" Style="{StaticResource Label}"/>
        <TextBox x:Name="Input"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button Content="Cancel" Style="{StaticResource Ghost}" IsCancel="True" Margin="0,0,8,0"/>
            <Button Content="OK" Style="{StaticResource Primary}" IsDefault="True" Click="OnOk"/>
        </StackPanel>
    </StackPanel>
</Window>
