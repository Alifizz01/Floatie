<Window x:Class="Floatie.Views.TidyWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource Dialog}" Title="Tidy a folder" WindowStartupLocation="CenterScreen" SizeToContent="Manual"
        Width="620" Height="560" ResizeMode="CanResize" MinWidth="480" MinHeight="380">
    <Grid Margin="24,16,24,22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock FontFamily="{StaticResource DisplayFont}" FontSize="20" FontWeight="SemiBold" Text="Tidy a folder"/>
            <TextBlock Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,4,0,0"
                       Text="Sorts loose files into category folders. Nothing is overwritten, files still downloading or changed in the last 2 minutes are skipped, and you can undo the last tidy at any time."/>
        </StackPanel>

        <DockPanel Grid.Row="1" Margin="0,16,0,10">
            <Button DockPanel.Dock="Right" Content="Change…" Style="{StaticResource Ghost}" Click="OnPickFolder" Margin="8,0,0,0"/>
            <Border Background="{StaticResource Field}" CornerRadius="6" Padding="10,7">
                <TextBlock x:Name="FolderText" TextTrimming="CharacterEllipsis"/>
            </Border>
        </DockPanel>

        <Border Grid.Row="2" Background="#14FFFFFF" CornerRadius="8">
            <Grid>
                <ListView x:Name="PlanList" Background="Transparent" BorderThickness="0" Foreground="{StaticResource Ink}"
                          ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListViewItem">
                                        <ContentPresenter Margin="12,5"/>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="110"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding File}" TextTrimming="CharacterEllipsis" ToolTip="{Binding File}"/>
                                <TextBlock Grid.Column="1" Text="&#xE72A;" FontFamily="{StaticResource Glyphs}" FontSize="10"
                                           Foreground="{StaticResource Muted}" Margin="12,3,12,0"/>
                                <TextBlock Grid.Column="2" Text="{Binding Category}" Foreground="{StaticResource Accent}" FontWeight="SemiBold"/>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
                <TextBlock x:Name="EmptyText" Foreground="{StaticResource Muted}" HorizontalAlignment="Center" VerticalAlignment="Center"
                           TextAlignment="Center" TextWrapping="Wrap" Margin="24"/>
            </Grid>
        </Border>

        <DockPanel Grid.Row="3" Margin="0,16,0,0">
            <Button x:Name="UndoButton" Content="Undo last tidy" Style="{StaticResource Ghost}" Click="OnUndo"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Close" Style="{StaticResource Ghost}" Click="OnClose" Margin="0,0,8,0"/>
                <Button x:Name="ApplyButton" Style="{StaticResource Primary}" Click="OnApply"/>
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
