<Window x:Class="Floatie.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Floatie"
        Height="1080"
        Width="1920"
        Background="Transparent"
        WindowStyle="None"
        AllowsTransparency="True"
        Topmost="False"
        ResizeMode="NoResize">

    <Canvas Name="MainCanvas" Background="Transparent">
        <!-- Our floating panel -->
        <Border Name="FencePanel"
                Background="#66000000"              
                BorderBrush="#FFCCCCCC"
                BorderThickness="1"
                Width="415" Height="387"
                Canvas.Left="58"
                MouseLeftButtonDown="FencePanel_MouseLeftButtonDown"
                MouseMove="FencePanel_MouseMove"
                MouseLeftButtonUp="FencePanel_MouseLeftButtonUp"
                CornerRadius="10"
                Padding="10" Canvas.Top="37">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <!-- Title row -->
                    <RowDefinition Height="*"/>
                    <!-- Icon grid row -->
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <TextBlock Text="🧩 Floatie Panel"
                   FontWeight="Bold"
                   Foreground="White"
                   Margin="0 0 0 10"/>
                </Grid>

                <!-- Icon area -->
                <Grid Grid.Row="1" Margin="0 10 0 0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Button 1 -->
                    <Button Grid.Row="0" Grid.Column="0" Margin="5" Width="60" Height="70" Background="Transparent" BorderBrush="{x:Null}">
                        <StackPanel Orientation="Vertical" HorizontalAlignment="Center">
                            <Image Source="/Assets/folder.png" Width="32" Height="32" Stretch="Uniform"/>
                            <TextBlock Text="Folder" Foreground="White" FontSize="12" TextAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <!-- Button 2 -->
                    <Button Grid.Row="0" Grid.Column="1" Margin="5" Width="60" Height="70" Background="Transparent" BorderBrush="{x:Null}">
                        <StackPanel Orientation="Vertical" HorizontalAlignment="Center">
                            <Image Source="/Assets/pdf.png" Width="32" Height="32" Stretch="Uniform"/>
                            <TextBlock Text="PDF" Foreground="White" FontSize="12" TextAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <!-- Button 3 -->
                    <Button Grid.Row="1" Grid.Column="0" Margin="5" Width="60" Height="70" Background="Transparent" BorderBrush="{x:Null}">
                        <StackPanel Orientation="Vertical" HorizontalAlignment="Center">
                            <Image Source="/Assets/picture.png" Width="32" Height="32" Stretch="Uniform"/>
                            <TextBlock Text="Image" Foreground="White" FontSize="12" TextAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <!-- Button 4 -->
                    <Button Grid.Row="1" Grid.Column="1" Margin="5" Width="60" Height="70" Background="Transparent" BorderBrush="{x:Null}">
                        <StackPanel Orientation="Vertical" HorizontalAlignment="Center">
                            <Image Source="/Assets/documents.png" Width="32" Height="32" Stretch="Uniform"/>
                            <TextBlock Text="Document" Foreground="White" FontSize="12" TextAlignment="Center" />
                        </StackPanel>
                    </Button>
                </Grid>
            </Grid>
        </Border>
    </Canvas>
</Window>

