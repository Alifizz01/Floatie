<Window x:Class="Floatie.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Main Launcher"
        Height="300"
        Width="300"
        WindowStartupLocation="CenterScreen"
        Background="Black"
        Foreground="White"
        ResizeMode="NoResize">

    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
        <TextBlock Text="Floatie Widget Launcher"
                   FontSize="16"
                   FontWeight="Bold"
                   TextAlignment="Center"
                   Margin="0 0 0 20"/>

        <Button Content="Launch Floaties"
                Width="200"
                Height="40"
                Click="LaunchFloatieWidgets"
                Margin="0 0 0 10"/>
    </StackPanel>
</Window>